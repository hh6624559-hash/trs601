# Sao chép thành .env (KHÔNG commit). Tạo bí mật:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=production
PORT=8080
APP_SECRET=
PUBLIC_ORIGIN=https://ten-mien-cua-ban.example.com
DATABASE_PATH=/data/trs6.sqlite
# console = in thư ra log (chỉ để thử) | webhook = gửi qua EMAIL_WEBHOOK_URL tới dịch vụ email của bạn
EMAIL_MODE=console
EMAIL_FROM=TRS6 <no-reply@ten-mien-cua-ban.example.com>
EMAIL_WEBHOOK_URL=
# Đăng ký mở cho người lớn (giáo viên/phụ huynh/học viên 18+)
OPEN_SIGNUP=true
# Tin nhắn tự do cho 13–17 tuổi: mặc định TẮT (chỉ tin soạn sẵn)
FREE_TEXT_TEEN=false
VIDEO_WEBHOOK_SECRET=
HIBP_CHECK=false
# Phòng học / đấu trường
MEDIA_PROVIDER=p2p
ICE_SERVERS=[]
ROOM_MAX_PEOPLE=20
MEDIA_WEBHOOK_SECRET=
# AI (tắt mặc định; adapter chưa kiểm chứng)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Nơi không có Shell (vd Render gói free): tự tạo quản trị lần khởi động đầu. Xoá hai biến này sau khi đã tạo xong.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# CHỈ chạy thử: giáo viên đăng ký được tự xác minh email và tự duyệt
DEMO_MODE=false
# Mặc định ở production: mọi tài khoản (mới và cũ) tự được duyệt + xác minh email. Đặt false để duyệt thủ công.
AUTO_APPROVE=true
# Bật AI (cờ ai.gateway). Khoá Gemini: đặt ở đây hoặc nhập trên trang «Trợ lý AI»
AI_GATEWAY=false
GEMINI_API_KEY=
